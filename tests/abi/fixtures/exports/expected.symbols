# Self-test list for tests/abi/check_symbols.cmake: the names exported in the
# recorded dumps of this directory (nm-elf.txt and the other formats).
# clopts_argv_create_from_wide carries the "windows" tag: it appears only in the
# Windows dumps (dumpbin, objdump-pe) and is dropped from the expected set for
# nm-elf and nm-macho.

# clopts/decl.h
clopts_program_create
clopts_program_destroy
clopts_command_add_flag
clopts_option_set_help

# clopts/parse/parse.h
clopts_parse
clopts_result_get_status
clopts_result_destroy

# clopts/process/argv.h
clopts_argv_create
clopts_argv_create_from_wide windows
clopts_argv_destroy
clopts_env_create
clopts_env_destroy

# clopts/text.h
clopts_write_help
