# Self-test list for tests/abi/check_symbols.cmake: the names exported in the
# recorded dumps of this directory (nm-elf.txt and the other formats).
# clopts_argv_from_wide carries the "windows" tag: it appears only in the
# Windows dumps (dumpbin, objdump-pe) and is dropped from the expected set for
# nm-elf and nm-macho.

# clopts/decl.h
clopts_program_new
clopts_program_free
clopts_command_add_flag
clopts_option_set_help

# clopts/help.h
clopts_write_help

# clopts/parse.h
clopts_parse
clopts_result_status
clopts_result_free

# clopts/platform.h
clopts_argv_get
clopts_argv_from_wide windows
clopts_argv_free
clopts_env_new
clopts_env_free
